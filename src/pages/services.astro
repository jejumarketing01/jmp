---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  "title": "주요 서비스 | 제주마케팅파트너스 · 가게 홍보 영상 촬영 · 네이버·인스타·유튜브 광고 관리",
  "description": "제주 가게에 찾아가 인스타·유튜브용 20초 홍보 영상을 촬영하고, 네이버 플레이스·파워링크·인스타·페이스북·유튜브 광고를 관리합니다. 장사가 안 되는 이유를 찾고 간판·인테리어 업체도 연결해 드립니다.",
  "canonical": "https://jejumarketing.co.kr/services",
  "ogTitle": "주요 서비스 | 제주마케팅파트너스",
  "ogDescription": "가게에 찾아가 홍보 영상을 찍고, 광고를 관리합니다. 장사가 안 되는 이유도 찾아드립니다.",
  "bodyClass": "page-services",
  "pageStylesheet": "/assets/css/pages/services.css",
  "activePage": "services",
  "showContactCta": true
} as const;
---

<BaseLayout {...page}>
  <Fragment slot="head">
<link rel="preload" as="image" href="/assets/img/services/svc-hero.webp" type="image/webp" fetchpriority="high">
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "가게 홍보 영상 촬영",
        "description": "제주 가게에 찾아가 촬영(1회 2시간 30분)하고, 인스타·유튜브용 20초 홍보 영상을 계약 후 7일 안에 전달. 수정 2회 무료.",
        "provider": { "@type": "ProfessionalService", "name": "제주마케팅파트너스" },
        "areaServed": "제주특별자치도"
      },
      {
        "@type": "Service",
        "name": "광고 관리",
        "description": "네이버 플레이스 정보 정리, 플레이스 광고·파워링크, 인스타·페이스북·유튜브 광고 설정과 관리. 매달 결과 설명.",
        "provider": { "@type": "ProfessionalService", "name": "제주마케팅파트너스" },
        "areaServed": "제주특별자치도"
      },
      {
        "@type": "Service",
        "name": "컨설팅",
        "description": "메뉴·가격·간판을 살펴 장사가 안 되는 이유를 찾고, 필요하면 간판·인테리어 업체를 연결.",
        "provider": { "@type": "ProfessionalService", "name": "제주마케팅파트너스" },
        "areaServed": "제주특별자치도"
      }
    ]
  }
  </script>
  </Fragment>

    <!-- ================= 1. 인트로 ================= -->
    <section class="page-intro" aria-labelledby="page-title">
      <div class="container page-intro__inner">
        <div class="page-intro__copy">
          <p class="eyebrow" aria-hidden="true">Services</p>
          <h1 class="display" id="page-title">주요 <span class="accent">서비스</span></h1>
          <div class="lead page-intro__lead">
            <p>가게에 찾아가 홍보 영상을 찍고, 광고를 관리합니다.</p>
            <p>장사가 안 되는 이유도 찾아드립니다.</p>
            <p>가게에 필요한 것만 골라서 합니다.</p>
          </div>
          <nav aria-label="서비스 바로가기">
            <ul class="jump-links">
              <li><a href="#video"><span>01</span><span>영상</span></a></li>
              <li><a href="#ads"><span>02</span><span>광고</span></a></li>
              <!-- TODO: 서비스 이름 '컨설팅' 확정 필요 -->
              <li><a href="#consult"><span>03</span><span>컨설팅</span></a></li>
            </ul>
          </nav>
        </div>
        <div class="page-intro__visual">
          <img class="img-cover ratio-16x10" src="/assets/img/services/svc-hero.webp" alt="가게에서 사장님을 촬영하는 모습" width="1600" height="1000" fetchpriority="high">
        </div>
      </div>
    </section>

    <!-- ================= 2. 01 영상 ================= -->
    <section class="section section--soft svc svc--video" id="video" aria-labelledby="video-title">
      <div class="container">
        <div class="svc__grid">
          <header class="svc__head reveal">
            <p class="svc__label"><span>01</span> 영상</p>
            <h2 class="h2" id="video-title">인스타·유튜브용 <span class="accent">20초 홍보 영상</span>을 만듭니다</h2>
            <div class="svc__lead">
              <p>가게에 찾아가 촬영합니다.</p>
              <p>영업에 지장 없는 시간에 갑니다.</p>
              <p>촬영은 한 번에 2시간 30분입니다.</p>
              <p>계약 후 7일 안에 영상을 드립니다.</p>
            </div>
            <a class="link-arrow" href="/pricing#video">영상 가격 보기</a>
          </header>

          <ul class="feature-grid">
              <li class="reveal">
                <span class="feature-grid__num" aria-hidden="true">01</span>
                <h3 class="h3">사전 미팅 2회</h3>
                <p>가게를 보고 무엇을 찍을지 정합니다.</p>
              </li>
              <li class="reveal">
                <span class="feature-grid__num" aria-hidden="true">02</span>
                <h3 class="h3">촬영 1회</h3>
                <p>2시간 30분 동안 촬영합니다.</p>
              </li>
              <li class="reveal">
                <span class="feature-grid__num" aria-hidden="true">03</span>
                <h3 class="h3">20초 홍보 영상</h3>
                <p>인스타·유튜브에 바로 올릴 수 있게 만듭니다.</p>
              </li>
              <li class="reveal">
                <span class="feature-grid__num" aria-hidden="true">04</span>
                <h3 class="h3">수정 2회 무료</h3>
                <p>영상을 보시고 두 번까지 고쳐 드립니다.</p>
              </li>
          </ul>
        </div>

        <!-- 예시 영상: 세로(9:16) -->
        <div class="shorts">
          <aside class="notice reveal" aria-labelledby="notice-title">
            <h3 class="h3" id="notice-title">사장님이 나오시는 편이 좋습니다</h3>
            <p>손님은 가게보다 사람을 기억하기 때문입니다.</p>
            <p>말을 잘하지 못해도 괜찮습니다.</p>
            <p>할 말은 촬영 전에 정리해 드립니다.</p>
            <p>어려우시면 손이나 뒷모습만 담을 수도 있습니다.</p>
          </aside>
          <ul class="shorts__list">
            <li>
              <a class="shorts__link" href="https://www.instagram.com/p/DfRv82azqJ1/" target="_blank" rel="noopener">
                <figure class="shorts__item">
                  <img class="img-cover ratio-9x16" src="/assets/img/services/svc-short-1.webp?v=20261105-crop" alt="장모식탁 외관" width="720" height="1280" loading="lazy">
                  <figcaption><strong>장모식탁</strong> · 스마트스토어 상품 홍보<span class="sr-only"> (새 창)</span></figcaption>
                </figure>
              </a>
            </li>
            <li>
              <a class="shorts__link" href="https://www.instagram.com/p/DdSlowkk3fi/" target="_blank" rel="noopener">
                <figure class="shorts__item">
                  <img class="img-cover ratio-9x16" src="/assets/img/services/svc-short-2.webp?v=20261105-crop" alt="충민정 외관" width="720" height="1280" loading="lazy">
                  <figcaption><strong>충민정</strong> · 숏폼 홍보 영상<span class="sr-only"> (새 창)</span></figcaption>
                </figure>
              </a>
            </li>
            <li>
              <a class="shorts__link" href="https://www.instagram.com/p/DfRwRXwz4b5/" target="_blank" rel="noopener">
                <figure class="shorts__item">
                  <img class="img-cover ratio-9x16" src="/assets/img/services/svc-short-3.webp?v=20261105-crop" alt="다정이네김밥 외관" width="720" height="1280" loading="lazy">
                  <figcaption><strong>다정이네</strong> · 팝업 홍보 영상<span class="sr-only"> (새 창)</span></figcaption>
                </figure>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= 3. 02 광고 ================= -->
    <section class="section svc svc--ads" id="ads" aria-labelledby="ads-title">
      <div class="container">
        <div class="svc__grid svc__grid--media">
          <header class="svc__head reveal">
            <p class="svc__label"><span>02</span> 광고</p>
            <h2 class="h2" id="ads-title">광고 결과, <span class="accent">숫자로 보여드립니다</span></h2>
            <div class="svc__lead">
              <p>매달 직접 만나서 설명합니다.</p>
            </div>
          </header>
          <div class="svc__media reveal">
            <img class="img-cover ratio-4x3" src="/assets/img/home/service-ads.webp" alt="광고 결과 화면을 사장님께 설명하는 모습" width="1200" height="900" loading="lazy">
          </div>
        </div>

        <ul class="ad-cards">
          <li class="ad-card reveal">
            <h3 class="h3">네이버</h3>
            <p>플레이스에 가게 정보를 정리합니다.</p>
            <p>플레이스 광고와 파워링크를 대신 맡아 관리합니다.</p>
            <p class="ad-card__note">플레이스 순위는 네이버가 정해서, 보장하지 않습니다.</p>
          </li>
          <li class="ad-card reveal">
            <h3 class="h3">인스타·페이스북</h3>
            <p>제주 여행을 준비하는 사람에게 가게 영상을 보여줍니다.</p>
            <p>관광객은 제주에 오기 전에 갈 가게를 정하기 때문입니다.</p>
          </li>
          <li class="ad-card reveal">
            <h3 class="h3">유튜브</h3>
            <p>유튜브 채널을 만들어 드립니다.</p>
            <p>유튜브 광고를 설정하고 관리합니다.</p>
            <p>만든 영상은 쇼츠에도 올려 드립니다.</p>
          </li>
          <li class="ad-card reveal">
            <h3 class="h3">매달 관리</h3>
            <p>한 달에 한 번 결과를 설명합니다.</p>
            <p>가게나 사무실에서 만나고, 보고서로만 받으셔도 됩니다.</p>
            <p>그달 한 일과 다음 달 할 일은 보고서로 드립니다.</p>
          </li>
        </ul>

        <div class="svc__foot reveal">
          <p class="svc__cost">광고비(네이버·인스타에 내는 돈)는 따로 듭니다.</p>
          <a class="link-arrow" href="/pricing#ads">광고 가격 보기</a>
        </div>
      </div>
    </section>

    <div class="wide-photo">
      <img class="img-cover ratio-21x9" src="/assets/img/services/svc-wide.webp?v=20261105-work1" alt="책장과 테이블이 있는 밝은 공간" width="2400" height="1030" loading="lazy">
    </div>

    <!-- ================= 4. 03 컨설팅 ================= -->
    <section class="section svc svc--consult" id="consult" aria-labelledby="consult-title">
      <div class="container">
        <div class="svc__grid">
          <header class="svc__head reveal">
            <!-- TODO: 서비스 이름 '컨설팅' 확정 필요 -->
            <p class="svc__label"><span>03</span> 컨설팅</p>
            <h2 class="h2" id="consult-title">장사가 안 되는 이유를 <span class="accent">찾아드립니다</span></h2>
            <div class="svc__lead">
              <p>손님이 안 오는 게 광고 때문이 아닐 때도 많습니다.</p>
              <p>메뉴·가격·간판을 살펴봅니다.</p>
              <p>간판·인테리어 업체도 연결해 드립니다.</p>
            </div>
            <a class="link-arrow" href="/cases">성공사례 12곳 전체 보기</a>
          </header>

          <ul class="result-list">
            <li class="reveal">
              <article class="result">
                <h3 class="result__name">안녕전복</h3>
                <p class="result__meta">제주시 도두동 · 2·3인 세트메뉴 제안</p>
                <p class="result__num">일매출 약 100만원 → 약 300만원</p>
              </article>
            </li>
            <li class="reveal">
              <article class="result">
                <h3 class="result__name">중문우동한그릇</h3>
                <p class="result__meta">서귀포 중문 · 제주 녹차면 메뉴 제안</p>
                <p class="result__num">2026년 2월 비수기 웨이팅 120명</p>
              </article>
            </li>
            <li class="reveal">
              <article class="result">
                <h3 class="result__name">소플러스 제주노형공항점</h3>
                <p class="result__meta">제주시 노형동 · 현수막으로 상호를 알리고 점심특선 홍보</p>
                <p class="result__num">4개월 총매출 +33.6%</p>
              </article>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= 5. 진행 순서 ================= -->
    <section class="section section--soft process" aria-labelledby="process-title">
      <div class="container">
        <div class="process__head reveal">
          <p class="eyebrow" aria-hidden="true">Process</p>
          <h2 class="h2" id="process-title">진행 순서</h2>
          <p class="lead">문의하시면 이렇게 진행합니다.</p>
        </div>
        <ol class="steps">
          <li class="reveal">
            <h3 class="steps__title">문의</h3>
            <p>카카오톡·전화·상담 신청</p>
          </li>
          <li class="reveal">
            <h3 class="steps__title">전화 통화</h3>
            <p>가게 상황을 듣고 만날 날을 정합니다.</p>
          </li>
          <li class="reveal">
            <h3 class="steps__title">만나서 계약</h3>
            <p>제주시 사무실에서 만납니다.<br>필요하면 가게로 갑니다.</p>
          </li>
          <li class="reveal">
            <h3 class="steps__title">사전 미팅·기획</h3>
            <p>무엇을 찍고, 어디에 광고할지 정합니다.</p>
          </li>
          <li class="reveal">
            <h3 class="steps__title">촬영·영상 전달</h3>
            <p>2시간 30분 촬영합니다.<br>계약 후 7일 안에 영상을 드립니다.</p>
          </li>
          <li class="reveal">
            <h3 class="steps__title">매달 관리</h3>
            <p>매달 결과를 설명하고, 보고서를 드립니다.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ================= 6. 하지 않는 일 ================= -->
    <section class="section section--peach not-do" aria-labelledby="notdo-title">
      <div class="container not-do__inner reveal">
        <div>
          <h2 class="h2" id="notdo-title">하지 않는 일</h2>
          <p class="lead">잘하는 일에만 집중하려고 합니다.</p>
        </div>
        <ul class="not-do__list">
          <li>홈페이지 제작</li>
          <li>제주 밖 촬영</li>
          <li>간판·인테리어 시공</li>
        </ul>
      </div>
    </section>

    <!-- ================= 7. 하단 문의 (모든 페이지 공통) ================= -->
</BaseLayout>
