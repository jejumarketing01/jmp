---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  "title": "제주마케팅파트너스 | 제주에 있는 마케팅 회사 · 가게 홍보 영상 · 광고 관리",
  "description": "제주시 연북로에 있는 마케팅 회사입니다. 음식점·필라테스·뷰티 가게에 직접 찾아가 홍보 영상을 촬영하고, 네이버 플레이스·인스타·유튜브 광고를 관리합니다. 제주 전 지역 출장비 없음.",
  "canonical": "https://jejumarketing.co.kr/",
  "ogTitle": "제주에 있는 마케팅 회사, 직접 찾아갑니다",
  "ogDescription": "전화 말고, 가게에서 만나 이야기합니다. 제주 전 지역 출장비 없음.",
  "bodyClass": "page-home",
  "pageStylesheet": "/assets/css/pages/home.css",
  "showContactCta": true
} as const;
---

<BaseLayout {...page}>
  <Fragment slot="head">
  <link rel="preload" as="image" href="/assets/img/home/hero-1.webp" type="image/webp" fetchpriority="high">
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "제주마케팅파트너스",
    "legalName": "주식회사 제이엠피",
    "description": "제주시에 있는 마케팅 회사. 가게 홍보 영상 촬영, 네이버 플레이스·인스타·유튜브 광고 관리, 매달 직접 만나 결과 설명.",
    "founder": "한승지",
    "telephone": "+82-10-7538-5083",
    "email": "help@jejumarketing.co.kr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "연북로 161, 2층 215호",
      "addressLocality": "제주시",
      "addressRegion": "제주특별자치도",
      "addressCountry": "KR"
    },
    "areaServed": "제주특별자치도",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday"], "opens": "09:30", "closes": "18:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "09:00", "closes": "18:00" }
    ]
  }
  </script>
  </Fragment>

    <!-- ================= 1. 메인 배너 (3장) ================= -->
    <section class="hero" aria-roledescription="carousel" aria-label="메인 배너" data-hero>
      <p class="hero__side" aria-hidden="true">JEJU MARKETING PARTNERS</p>
      <div class="container hero__inner">

        <div class="hero__copy">
          <div class="hero__slides" aria-live="off" data-hero-slides>
            <div class="hero__slide is-active" role="group" aria-roledescription="slide" aria-label="1 / 3">
              <p class="hero__kicker">제주시 연북로 · 제주 전 지역 출장비 없음</p>
              <h1 class="display hero__title"><span class="line">제주에 있는</span> <span class="line">마케팅 회사,</span> <span class="accent">직접 찾아갑니다</span></h1>
              <p class="lead hero__lead">전화 말고, 가게에서 만나 이야기합니다<br>음식점·필라테스·뷰티, 매장이 있으면 어디든</p>
            </div>
            <div class="hero__slide" role="group" aria-roledescription="slide" aria-label="2 / 3">
              <p class="hero__kicker">인스타·유튜브용 20초 영상</p>
              <p class="display hero__title">가게 홍보 영상, <span class="accent">7일 안에 드립니다</span></p>
              <p class="lead hero__lead">가게에 찾아가 촬영합니다</p>
            </div>
            <div class="hero__slide" role="group" aria-roledescription="slide" aria-label="3 / 3">
              <p class="hero__kicker">한 달 단위 계약 · 위약금 없음</p>
              <p class="display hero__title">한 달 해보고 <span class="accent">정하세요</span></p>
              <p class="lead hero__lead">6개월, 1년으로 묶지 않습니다</p>
            </div>
          </div>

          <div class="hero__cta">
            <div class="btn-group">
              <a class="btn btn--primary" href="https://pf.kakao.com/_xhxlYGG/chat" target="_blank" rel="noopener">카카오톡으로 문의하기</a>
              <a class="btn btn--ghost" href="/contact#consult">상담 신청하기</a>
            </div>
            <p class="btn-note">신청해 주시면 전화로 먼저 안내드립니다</p>
          </div>
        </div>

        <div class="hero__visual" data-hero-visuals>
          <div class="hero__media is-active">
            <img class="img-cover ratio-16x10" src="/assets/img/home/hero-1.webp" alt="대표가 가게에서 사장님과 이야기하는 모습" width="1600" height="1000" fetchpriority="high">
          </div>
          <div class="hero__media" aria-hidden="true">
            <img class="img-cover ratio-16x10" src="/assets/img/home/hero-2.webp" alt="" width="1600" height="1000">
          </div>
          <div class="hero__media" aria-hidden="true">
            <img class="img-cover ratio-16x10" src="/assets/img/home/hero-3.webp" alt="" width="1600" height="1000">
          </div>
        </div>

        <div class="hero__controls">
          <p class="hero__count" aria-hidden="true"><span data-hero-current>01</span> / 03</p>
          <button class="hero__arrow hero__arrow--prev" type="button" data-hero-prev><span class="sr-only">이전 배너</span></button>
          <button class="hero__arrow hero__arrow--next" type="button" data-hero-next><span class="sr-only">다음 배너</span></button>
          <button class="hero__pause" type="button" data-hero-pause aria-pressed="false"><span class="sr-only">자동 넘김 멈추기</span></button>
        </div>
      </div>
    </section>

    <!-- ================= 2. 상황별 안내 ================= -->
    <section class="section section--soft paths" aria-labelledby="paths-title">
      <div class="container">
        <h2 class="sr-only" id="paths-title">상황별 안내</h2>
        <div class="paths__grid">
          <article class="line-card reveal">
            <h3 class="h3">다른 대행사에 맡겼는데 관리가 안 되나요?</h3>
            <p>처음엔 잘해주다가 두 달쯤 지나면 연락이 뜸해지는 곳, 많습니다.<br>저희는 한 달에 한 번 사장님을 직접 만납니다.</p>
            <a class="link-arrow" href="#why">관리 방식 보기</a>
          </article>
          <article class="line-card reveal">
            <h3 class="h3">홍보가 처음이신가요?</h3>
            <p>뭘 해야 할지 모르겠어도 괜찮습니다.<br>가게를 직접 보고, 지금 필요한 것부터 말씀드립니다.</p>
            <a class="link-arrow" href="/pricing">얼마나 드는지 보기</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 3. 주요 서비스 ================= -->
    <section class="section services" id="services" aria-labelledby="services-title">
      <div class="container services__inner">
        <div class="services__intro reveal">
          <p class="eyebrow" aria-hidden="true">Services</p>
          <h2 class="h2" id="services-title">주요 서비스</h2>
          <p class="lead">가게에 찾아가 촬영하고, 광고를 관리합니다.</p>
          <div class="services__links">
            <a class="link-arrow" href="/services">서비스 자세히 보기</a>
            <a class="link-arrow" href="/pricing">가격 보기</a>
          </div>
          <div class="rail-nav" data-rail-nav="services">
            <button class="rail-nav__btn" type="button" data-rail-prev><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="sr-only">이전 서비스</span></button>
            <button class="rail-nav__btn" type="button" data-rail-next><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg><span class="sr-only">다음 서비스</span></button>
          </div>
        </div>

        <ul class="rail services__rail" data-rail="services">
          <li>
            <article class="service-card">
              <img class="img-cover ratio-4x3" src="/assets/img/home/service-video.webp" alt="음식을 촬영하는 장면" width="1200" height="900" loading="lazy">
              <div class="service-card__body">
                <p class="service-card__tag">영상</p>
                <h3 class="h3">인스타·유튜브용 20초 홍보 영상을 만듭니다</h3>
                <p>가게에 찾아가 촬영합니다.<br>계약 후 7일 안에 드립니다.</p>
              </div>
            </article>
          </li>
          <li>
            <article class="service-card">
              <img class="img-cover ratio-4x3" src="/assets/img/home/service-ads.webp" alt="광고 결과 화면을 사장님께 설명하는 모습" width="1200" height="900" loading="lazy">
              <div class="service-card__body">
                <p class="service-card__tag">광고</p>
                <h3 class="h3">광고 결과, 숫자로 보여드립니다</h3>
                <p>네이버·인스타·유튜브 광고를 대신 맡아 관리합니다.<br>매달 직접 만나서 설명합니다.</p>
                <p class="service-card__note">플레이스 순위는 네이버가 정해서, 보장하지 않습니다.</p>
              </div>
            </article>
          </li>
          <li>
            <article class="service-card">
              <img class="img-cover ratio-4x3" src="/assets/img/home/service-consult.webp" alt="가게 운영 방향을 상담하는 모습" width="1200" height="900" loading="lazy">
              <div class="service-card__body">
                <!-- TODO: 서비스 이름 '컨설팅' 확정 필요 -->
                <p class="service-card__tag">컨설팅</p>
                <h3 class="h3">장사가 안 되는 이유를 찾아드립니다</h3>
                <p>메뉴·가격·간판을 살펴봅니다.<br>간판·인테리어 업체도 연결해 드립니다.</p>
              </div>
            </article>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= 4. 중간 문의 띠 ================= -->
    <section class="section section--peach cta-band" aria-labelledby="band-title">
      <div class="container cta-band__inner reveal">
        <h2 class="h2" id="band-title">견적이 궁금하신가요?</h2>
        <a class="btn btn--primary" href="https://pf.kakao.com/_xhxlYGG/chat" target="_blank" rel="noopener">카카오톡으로 문의하기</a>
      </div>
    </section>

    <!-- ================= 5. 차별점 ================= -->
    <div class="wide-photo">
      <img class="img-cover ratio-21x9" src="/assets/img/home/wide-meeting.webp" alt="가게에서 사장님과 저희 팀이 함께 이야기하는 모습" width="2400" height="1030" loading="lazy">
    </div>

    <section class="section why" id="why" aria-labelledby="why-title">
      <div class="container why__inner">
        <div class="why__intro reveal">
          <p class="eyebrow" aria-hidden="true">Why us</p>
          <h2 class="h2" id="why-title">이런 점이 <span class="accent">다릅니다</span></h2>

          <aside class="ceo" aria-label="대표 소개">
            <img class="img-cover ratio-1x1 ceo__photo" src="/assets/img/home/ceo.webp" alt="대표 한승지" width="800" height="800" loading="lazy">
            <div>
              <p class="ceo__name">대표 한승지</p>
              <p class="ceo__text">매달 사장님들께 마케팅 강의를 합니다.</p>
              <a class="link-arrow" href="/about">대표 소개 보기</a>
            </div>
          </aside>
        </div>

        <ol class="num-list why__list">
          <li class="reveal">
            <div>
              <h3 class="h3">한 달에 한 번, 직접 만납니다</h3>
              <p>가게나 사무실에서 만나 결과를 설명합니다.<br>그달 한 일과 다음 달 할 일은 정리해서 드립니다.</p>
            </div>
          </li>
          <li class="reveal">
            <div>
              <h3 class="h3">대표가 직접 관리합니다</h3>
              <p>대표가 상담하고 담당자를 정합니다.<br>담당자의 일과 결과는 대표가 챙깁니다.<br>중간에 담당자가 바뀌지 않습니다.</p>
            </div>
          </li>
          <li class="reveal">
            <div>
              <h3 class="h3">메뉴·가격·간판까지 봅니다</h3>
              <p>손님이 안 오는 게 광고 때문이 아닐 때도 많습니다.<br>필요하면 간판·인테리어 업체도 연결해 드립니다.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ================= 6. 성공사례 ================= -->
    <section class="section section--soft cases" id="cases" aria-labelledby="cases-title">
      <div class="container">
        <div class="cases__head reveal">
          <div>
            <p class="eyebrow" aria-hidden="true">Cases</p>
            <h2 class="h2" id="cases-title">성공사례</h2>
            <p class="lead">저희와 함께한 제주 가게입니다.</p>
          </div>
          <dl class="cases__stats">
            <div class="stat"><dt class="stat__label">함께한 제주 가게</dt><dd class="stat__num">60<em>여 곳</em></dd></div>
            <div class="stat"><dt class="stat__label">다음 달도 다시 맡기는 가게</dt><dd class="stat__num">90<em>%</em></dd></div>
            <div class="stat"><dt class="stat__label">평균 함께한 기간</dt><dd class="stat__num">1~5<em>년</em></dd></div>
          </dl>
        </div>
      </div>

      <div class="cases__rail-wrap">
        <ul class="rail cases__rail" data-rail="cases">
          <li>
            <article class="case-card">
              <img class="img-cover ratio-3x4" src="/assets/img/home/case-1.webp" alt="소플러스 제주노형공항점 외관" width="900" height="1200" loading="lazy">
              <p class="case-card__meta">소고기 전문점 · 제주시 노형동</p>
              <h3 class="case-card__name">소플러스 제주노형공항점</h3>
              <p class="case-card__result">4개월 총매출 7억 586만원 → 9억 4,289만원 <em>+33.6%</em></p>
              <p class="case-card__desc">영수증 5,008건 → 8,500건.<br>현수막으로 상호가 보이게 하고, 점심특선을 홍보했습니다.</p>
            </article>
          </li>
          <li>
            <article class="case-card">
              <img class="img-cover ratio-1x1" src="/assets/img/home/case-5.webp" alt="안녕전복 외관" width="900" height="900" loading="lazy">
              <p class="case-card__meta">제주시 도두동</p>
              <h3 class="case-card__name">안녕전복</h3>
              <p class="case-card__result">일매출 약 100만원 → 약 300만원</p>
              <p class="case-card__desc">2·3인 세트메뉴를 제안했습니다.</p>
            </article>
          </li>
          <li>
            <article class="case-card">
              <img class="img-cover ratio-3x4" src="/assets/img/home/case-4.webp" alt="중문우동한그릇 외관" width="900" height="1200" loading="lazy">
              <p class="case-card__meta">우동 전문점 · 서귀포 중문</p>
              <h3 class="case-card__name">중문우동한그릇</h3>
              <p class="case-card__result">2026년 2월 비수기 웨이팅 120명</p>
              <p class="case-card__desc">제주 녹차면 메뉴를 제안했습니다.</p>
            </article>
          </li>
          <li>
            <article class="case-card">
              <img class="img-cover ratio-1x1" src="/assets/img/home/case-6.webp" alt="고은물식당 외관" width="900" height="900" loading="lazy">
              <p class="case-card__meta">한정식 · 산방산 인근</p>
              <h3 class="case-card__name">고은물식당</h3>
              <p class="case-card__result">매출 2배</p>
              <p class="case-card__desc">1만원 정식을 가게 강점으로 홍보했습니다.</p>
            </article>
          </li>
          <li>
            <article class="case-card">
              <img class="img-cover ratio-3x4" src="/assets/img/home/case-3.webp" alt="다정이네김밥 외관" width="900" height="1200" loading="lazy">
              <p class="case-card__meta">김밥 전문점</p>
              <h3 class="case-card__name">다정이네김밥</h3>
              <p class="case-card__result">지점당 일매출 300~500만원</p>
              <p class="case-card__desc">여러 지점을 오래 관리하고 있습니다.</p>
            </article>
          </li>
          <li>
            <article class="case-card">
              <img class="img-cover ratio-1x1" src="/assets/img/home/case-2.webp" alt="고윤호 재활PT&amp;요가 외관" width="900" height="900" loading="lazy">
              <p class="case-card__meta">재활PT·요가 · 제주시 아라동</p>
              <h3 class="case-card__name">고윤호 재활PT&amp;요가</h3>
              <p class="case-card__result">오픈 첫 달 매출 1,000만원 → 둘째 달 1,500만원</p>
              <p class="case-card__desc">신규 상담 15건, 전원 등록했습니다.<br>오픈 초기 가게를 알렸습니다.</p>
            </article>
          </li>
        </ul>
      </div>

      <div class="container cases__foot">
        <a class="link-arrow" href="/cases">사례 전체 보기</a>
        <p class="small">가게마다 결과는 다릅니다.</p>
        <div class="rail-nav" data-rail-nav="cases">
          <button class="rail-nav__btn" type="button" data-rail-prev><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="sr-only">이전 사례</span></button>
          <button class="rail-nav__btn" type="button" data-rail-next><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg><span class="sr-only">다음 사례</span></button>
        </div>
      </div>
    </section>

    <!-- ================= 7. 사장님 후기 =================
         TODO: 후기 사용 허락을 받은 뒤 hidden 속성을 지운다. -->
    <section class="section voice" aria-labelledby="voice-title" hidden>
      <div class="container voice__inner">
        <h2 class="sr-only" id="voice-title">사장님 후기</h2>
        <figure class="voice__item">
          <blockquote><p>내 가게처럼 관리해줘서 <span class="accent">너무 좋다</span></p></blockquote>
          <figcaption>음식점 사장님</figcaption>
        </figure>
      </div>
    </section>

    <!-- ================= 8. 홍보 영상 샘플 ================= -->
    <section class="video" aria-labelledby="video-title">
      <h2 class="sr-only" id="video-title">저희가 만든 홍보 영상</h2>
      <img class="img-cover ratio-21x9 video__poster" src="/assets/img/home/video-poster.webp" alt="홍보 영상의 한 장면" width="2400" height="1030" loading="lazy">
      <button class="video__play" type="button" data-video-src="https://www.youtube.com/watch?v=gFTxOoaexqE">
        <span class="sr-only">홍보 영상 재생</span>
      </button>
    </section>

