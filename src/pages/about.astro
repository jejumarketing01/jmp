---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  "title": "소개 | 제주마케팅파트너스 대표 한승지 · 제주시 연북로 사무실",
  "description": "제주마케팅파트너스 대표 한승지 소개. 함께한 제주 가게 60여 곳, 매달 사장님들께 마케팅 강의, 자격증·수상. 사무실: 제주시 연북로 161, 2층 215호 (전용 주차 공간).",
  "canonical": "https://jejumarketing.co.kr/about",
  "ogTitle": "소개 | 제주마케팅파트너스 대표 한승지",
  "ogDescription": "광고를 시작하기 전에 가게를 먼저 봅니다.",
  "bodyClass": "page-about",
  "pageStylesheet": "/assets/css/pages/about.css",
  "activePage": "about",
  "showContactCta": true
} as const;
---

<BaseLayout {...page}>
  <Fragment slot="head">
<link rel="preload" as="image" href="/assets/img/about/about-ceo.webp" imagesrcset="/assets/img/about/about-ceo-mobile.webp 600w, /assets/img/about/about-ceo.webp 900w" imagesizes="(max-width: 959px) calc(100vw - 40px), 36vw" type="image/webp" fetchpriority="high">
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "한승지",
    "jobTitle": "대표",
    "worksFor": { "@type": "ProfessionalService", "name": "제주마케팅파트너스", "legalName": "주식회사 제이엠피",
      "address": { "@type": "PostalAddress", "streetAddress": "연북로 161, 2층 215호", "addressLocality": "제주시", "addressRegion": "제주특별자치도", "addressCountry": "KR" },
      "telephone": "+82-10-7538-5083" },
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "name": "GTQ 그래픽기술자격 1급", "recognizedBy": { "@type": "Organization", "name": "한국생산성본부(KPC)" } },
      { "@type": "EducationalOccupationalCredential", "name": "SNS광고마케터 1급", "recognizedBy": { "@type": "Organization", "name": "한국정보통신진흥협회(KAIT)" } },
      { "@type": "EducationalOccupationalCredential", "name": "AI 자격증", "recognizedBy": { "@type": "Organization", "name": "한국인공지능교육연구협회" } }
    ]
  }
  </script>
  </Fragment>

    <!-- ================= 1. 인트로 ================= -->
    <section class="page-intro about-intro" aria-labelledby="page-title">
      <div class="container page-intro__inner">
        <div class="page-intro__copy">
          <p class="eyebrow" aria-hidden="true">About</p>
          <h1 class="display" id="page-title">대표 <span class="accent">한승지</span></h1>
          <p class="lead page-intro__lead">제주에서 가게 사장님들의 홍보를 돕고 있습니다.</p>
        </div>
        <div class="page-intro__visual about-intro__visual">
          <img class="img-cover ratio-3x4" src="/assets/img/about/about-ceo.webp" srcset="/assets/img/about/about-ceo-mobile.webp 600w, /assets/img/about/about-ceo.webp 900w" sizes="(max-width: 959px) calc(100vw - 40px), 36vw" alt="대표 한승지" width="900" height="1200" fetchpriority="high">
        </div>
      </div>
    </section>

    <!-- ================= 2. 대표 인사 ================= -->
    <section class="section section--soft greeting" aria-labelledby="greeting-title">
      <div class="container split">
        <header class="split__head reveal">
          <p class="split__label" aria-hidden="true"><span>01</span> Greeting</p>
          <h2 class="h2" id="greeting-title">광고를 시작하기 전에 <span class="accent">가게를 먼저 봅니다</span></h2>
        </header>
        <div class="greeting__body reveal">
          <p class="greeting__lead">손님이 안 오는 게 광고 때문이 아닐 때도 많기 때문입니다.</p>
          <div class="greeting__text">
            <p>상담은 제가 직접 합니다.</p>
            <p>담당자를 정하고, 담당자의 일과 결과를 제가 챙깁니다.</p>
            <p>중간에 담당자가 바뀌지 않습니다.</p>
          </div>
          <p class="greeting__sign"><strong>한승지</strong> <span>제주마케팅파트너스 대표</span></p>
        </div>
      </div>
    </section>

    <!-- ================= 3. 숫자로 보는 기록 ================= -->
    <section class="section record" aria-labelledby="record-title">
      <div class="container record__inner">
        <div class="reveal">
          <p class="eyebrow" aria-hidden="true">Record</p>
          <h2 class="h2" id="record-title">숫자로 보는 기록</h2>
        </div>
        <dl class="record__stats reveal">
          <div class="stat"><dt class="stat__label">함께한 제주 가게</dt><dd class="stat__num">60<em>여 곳</em></dd></div>
          <div class="stat"><dt class="stat__label">다음 달도 다시 맡기는 가게</dt><dd class="stat__num">90<em>%</em></dd></div>
          <div class="stat"><dt class="stat__label">평균 함께한 기간</dt><dd class="stat__num">1~5<em>년</em></dd></div>
        </dl>
      </div>
    </section>

    <div class="wide-photo">
      <img class="img-cover ratio-21x9" src="/assets/img/about/about-lecture-wide.webp?v=20261105-crop" srcset="/assets/img/about/about-lecture-wide-mobile.webp 800w, /assets/img/about/about-lecture-wide.webp?v=20261105-crop 2400w" sizes="100vw" alt="촬영 장비를 놓고 영상 제작 강의를 진행하는 모습" width="2400" height="1030" loading="lazy">
    </div>

    <!-- ================= 4. 강의 ================= -->
    <section class="section lecture" aria-labelledby="lecture-title">
      <div class="container split">
        <header class="split__head reveal">
          <p class="split__label" aria-hidden="true"><span>02</span> Lecture</p>
          <h2 class="h2" id="lecture-title"><span class="line">매달 사장님들께</span> <span class="accent line">마케팅 강의를 합니다</span></h2>
          <div class="split__lead">
            <p>'소상공인마케팅공부방'에서 2025년 2월부터 매달 강의를 엽니다.</p>
            <p>네이버 플레이스, AI 활용, 광고 설정을 다룹니다.</p>
          </div>
        </header>
        <div class="lecture__body">
          <ol class="lecture-list reveal">
            <li>
              <p class="lecture-list__date"><time datetime="2025-05">2025년 5월</time></p>
              <div><h3 class="lecture-list__title">플레이스 최적화 원데이</h3></div>
            </li>
            <li>
              <p class="lecture-list__date"><time datetime="2025-05">2025년 5월</time></p>
              <div><h3 class="lecture-list__title">AI 기초반 / AI 응용반 원데이</h3></div>
            </li>
            <li>
              <p class="lecture-list__date"><time datetime="2025-09">2025년 9월</time></p>
              <div><h3 class="lecture-list__title">아싸렌탈 제주 워크숍</h3><p class="lecture-list__sub">네이버 플레이스·파워링크 광고</p></div>
            </li>
          </ol>
          <div class="lecture__photos reveal">
            <img class="img-cover ratio-4x3" src="/assets/img/about/about-lecture-1.webp" alt="AI 활용 강의를 진행하는 대표 한승지" width="1200" height="900" loading="lazy">
            <img class="img-cover ratio-4x3" src="/assets/img/about/about-lecture-2.webp" alt="강의 내용을 적으며 듣는 사장님들" width="1200" height="900" loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 5. 자격증·수상 ================= -->
    <section class="section section--soft certs" aria-labelledby="certs-title">
      <div class="container">
        <div class="certs__head reveal">
          <p class="split__label" aria-hidden="true"><span>03</span> Credentials</p>
          <h2 class="h2" id="certs-title">자격증·수상</h2>
        </div>
        <ul class="certs__grid">
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-01.webp" alt="마케팅 전문강사 임명장" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">마케팅 전문강사 임명장</h3>
              </figcaption>
            </figure>
          </li>
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-02.webp" alt="온라인마케팅 우수상" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">온라인마케팅 우수상</h3>
              </figcaption>
            </figure>
          </li>
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-03.webp" alt="상권분석 수료증" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">상권분석 수료증</h3>
              </figcaption>
            </figure>
          </li>
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-04.webp" alt="GTQ 그래픽기술자격 1급 자격취득 내역서" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">GTQ 그래픽기술자격 1급</h3><p class="cert__by">한국생산성본부(KPC)</p>
              </figcaption>
            </figure>
          </li>
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-05.webp" alt="SNS광고마케터 1급 보유 자격 안내" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">SNS광고마케터 1급</h3><p class="cert__by">한국정보통신진흥협회(KAIT)</p>
              </figcaption>
            </figure>
          </li>
          <li class="cert reveal">
            <figure>
              <div class="cert__img">
                <img class="img-cover ratio-3x4" src="/assets/img/about/cert-06.webp" alt="Odyssey AI Challenge 수료증" width="600" height="800" loading="lazy">
              </div>
              <figcaption>
                <h3 class="cert__name">AI 자격증</h3><p class="cert__by">한국인공지능교육연구협회</p>
              </figcaption>
            </figure>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= 6. 오시는 길 ================= -->
    <section class="section section--peach office" id="office" aria-labelledby="office-title">
      <div class="container office__inner">
        <div class="office__info reveal">
          <p class="split__label" aria-hidden="true"><span>04</span> Office</p>
          <h2 class="h2" id="office-title">오시는 길</h2>
          <address class="office__address">제주특별자치도 제주시<br>연북로 161, 2층 215호</address>
          <div class="office__text">
            <p>상담은 사무실에서 만나는 게 기본입니다.</p>
            <p>필요하면 가게로 찾아갑니다.</p>
          </div>
          <dl class="def-list office__list">
            <div><dt>주차</dt><dd>전용 주차 공간이 있습니다</dd></div>
            <div><dt>전화</dt><dd><a href="tel:010-7538-5083">010-7538-5083</a></dd></div>
            <div><dt>영업시간</dt><dd>월~목 09:30~18:30 · 금 09:00~18:00 · 토·일 휴무</dd></div>
          </dl>
          <div class="office__maps">
            <a class="link-arrow" href="https://map.naver.com/p/search/%EC%A0%9C%EC%A3%BC%EC%8B%9C%20%EC%97%B0%EB%B6%81%EB%A1%9C%20161" target="_blank" rel="noopener">네이버 지도<span class="sr-only"> (새 창)</span></a>
            <a class="link-arrow" href="https://map.kakao.com/?q=%EC%A0%9C%EC%A3%BC%EC%8B%9C%20%EC%97%B0%EB%B6%81%EB%A1%9C%20161" target="_blank" rel="noopener">카카오맵<span class="sr-only"> (새 창)</span></a>
          </div>
        </div>
        <div class="office__visual reveal">
          <div class="office__map">
            <iframe title="제주마케팅파트너스 사무실 위치 지도" src="https://www.google.com/maps?q=%EC%A0%9C%EC%A3%BC%EC%8B%9C%20%EC%97%B0%EB%B6%81%EB%A1%9C%20161&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <img class="img-cover ratio-4x3" src="/assets/img/about/about-office.webp" alt="제주마케팅파트너스 사무실" width="1200" height="900" loading="lazy">
        </div>
      </div>
    </section>

    <!-- ================= 7. 하단 문의 (모든 페이지 공통) ================= -->
</BaseLayout>
