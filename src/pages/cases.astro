                <h3 class="case__name" id="case-10">표선 한식 전문점</h3>
                <p class="case__result">매출 상승</p>
                
              <a class="link-arrow case__link" href="#" target="_blank" rel="noopener" data-todo="video-url">영상 보기<span class="sr-only"> (새 창)</span></a>
              </div>
            </article>
          </li>
          <li class="case reveal" data-filter-item="cases" data-cat="food">
            <article class="case__card" aria-labelledby="case-11">
              <div class="case__media">
                <img class="img-cover ratio-4x3" src="/assets/img/cases/case-11.webp" alt="상호를 흐리게 처리한 해물탕 전문점 외관" width="1200" height="900" loading="lazy">
